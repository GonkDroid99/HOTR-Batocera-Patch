#!/bin/bash
set -euo pipefail

# %CONTROLLERSCONFIG% expands to many arguments. SYSTEM is the only argument
# consumed here; everything else is passed through verbatim to configgen.
SYSTEM="${1:?HOTR system name missing}"
shift

case "$SYSTEM" in
  psx-hotr)
    EMULATOR="duckstation-lightgun"
    CORE="duckstation-lightgun"
    ;;
  ps2-hotr)
    EMULATOR="pcsx2-lightgun"
    CORE="pcsx2-lightgun"
    ;;
  *)
    echo "HOTR: unknown system: $SYSTEM" >&2
    exit 2
    ;;
esac

LAUNCHER=(python3 -m configgen.emulatorlauncher)
# Batocera 44 introduced batocera-launch and retained the old Python module
# only as a compatibility stub. Batocera 43 does not provide batocera-launch.
if command -v batocera-launch >/dev/null 2>&1; then
  LAUNCHER=(batocera-launch)
elif [ "$SYSTEM" = "psx-hotr" ]; then
  # Batocera 43's configgen has DuckStation under the stock emulator name;
  # Batocera 44 registers HOTR as its own emulator entry point.
  EMULATOR="duckstation"
fi

mkdir -p /userdata/system/logs
printf '\n[%s] HOTR game launch:' "$(date '+%Y-%m-%dT%H:%M:%S%z')" >>/userdata/system/logs/hotr-game-launch.log
printf ' %q' "${LAUNCHER[@]}" "$@" -system "$SYSTEM" -emulator "$EMULATOR" -core "$CORE" \
  >>/userdata/system/logs/hotr-game-launch.log
printf '\n' >>/userdata/system/logs/hotr-game-launch.log

exec "${LAUNCHER[@]}" \
  "$@" \
  -system "$SYSTEM" \
  -emulator "$EMULATOR" \
  -core "$CORE"
