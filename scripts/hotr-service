#!/bin/bash
# Batocera user service for Hook of the Reaper AppImage.
set -u
ROOT=/userdata/system/hotr
APPDIR="$ROOT/software/hook-of-the-reaper"
DAEMON="$APPDIR/hook-of-the-reaper"
SINDEN_BROKER="$ROOT/bin/hotr-sinden-broker.py"
LOGFILE=/userdata/system/logs/hook-of-the-reaper.log
SINDEN_LOG=/userdata/system/logs/hotr-sinden-broker.log
SINDEN_PID=/var/run/hotr-sinden-broker.pid
SINDEN_RUN=/var/run/hotr-sinden
SINDEN_CONTROL="$SINDEN_RUN/broker.sock"
SINDEN_ENABLE_FILE="$ROOT/sinden-tcp.enabled"
# Optional device override, one PLAYER=/dev/path per line (see README). Used by
# guns that do not appear as /dev/ttyACM* and by the VM acceptance run.
SINDEN_DEVICES_FILE="$ROOT/sinden-devices.conf"
SINDEN_PTY_BRIDGE_FILE="$ROOT/sinden-pty-bridge.enabled"
DATADIR=/userdata/system/hook-of-the-reaper/data
MAX_LOG_BYTES=1048576

# The service is explicitly headless.  The HOTR port launcher stops this
# service and launches the normal UI with --ui.
HOTR_UI_ARGS=(--headless)

mkdir -p /userdata/system/logs

SERVICE_ACTION="${1:-unknown}"
SERVICE_BOOT_ID="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)"
service_log(){
  printf '[%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$LOGFILE"
}
service_log "HOTR service script started: action=${SERVICE_ACTION} pid=$$ boot_id=${SERVICE_BOOT_ID}"

rotate_file() {
  # Keep one previous generation as <file>.old. The broker enforces the same cap
  # and suffix from inside the running process; this call only shrinks a legacy
  # file that grew before the handler existed.
  local file="$1" size
  [ -f "$file" ] || return 0
  size="$(wc -c <"$file" 2>/dev/null || echo 0)"
  [ "$size" -lt "$MAX_LOG_BYTES" ] && return 0
  mv -f "$file" "$file.old" 2>/dev/null || true
}

rotate_log() {
  rotate_file "$LOGFILE"
}

proc_cmdline() {
  # Processes can exit between the directory scan and this read. Use cat so
  # a disappearing /proc entry cannot produce a shell redirection warning.
  cat "/proc/$1/cmdline" 2>/dev/null | tr '\0' ' ' 2>/dev/null || true
}

# An AppImage launch has two processes. Only the mounted payload is the HOTR
# application instance; the persistent-path process is the AppImage runtime.
hotr_pids() {
  local p pid cmd
  for p in /proc/[0-9]*; do
    pid="${p##*/}"
    cmd="$(proc_cmdline "$pid")"
    case "$cmd" in
      /tmp/.mount_hook-*/usr/bin/HookOfTheReaper\ --headless*|/tmp/.mount_hook-*/usr/bin/HookOfTheReaper\ --no-ui*) printf '%s\n' "$pid" ;;
    esac
  done
}

hotr_runtime_pids() {
  local p pid cmd
  for p in /proc/[0-9]*; do
    pid="${p##*/}"
    cmd="$(proc_cmdline "$pid")"
    case "$cmd" in
      "$DAEMON"\ --headless*|"$DAEMON"\ --no-ui*) printf '%s\n' "$pid" ;;
    esac
  done
}

hotr_running() {
  [ -n "$(hotr_pids)" ]
}

cleanup_stale_qipc() {
  hotr_running && return 0
  rm -f /tmp/qipc_sharedmemory_HookOfTheReaper* \
        /tmp/qipc_systemsem_HookOfTheReaper* 2>/dev/null || true
}

start_sinden_broker() {
  [ -f "$SINDEN_ENABLE_FILE" ] || return 0
  [ -x "$SINDEN_BROKER" ] || return 0
  if [ -r "$SINDEN_PID" ] && kill -0 "$(cat "$SINDEN_PID" 2>/dev/null)" 2>/dev/null; then
    return 0
  fi
  rm -f "$SINDEN_PID"
  rotate_file "$SINDEN_LOG"
  # 13000 is HOTR's documented default. Configured Sinden profiles may add a
  # second port; the broker reads those from lightguns.hor as well.
  BROKER_ARGS=(--config "$DATADIR/lightguns.hor" --port 13000 --log "$SINDEN_LOG")
  if [ -f "$SINDEN_PTY_BRIDGE_FILE" ]; then
    # Legacy byte-transparent bridge: workers register over the control socket
    # and LightgunMono is handed a PTY instead of the real gun. Opt-in only;
    # the default backend writes the gun directly and needs no control socket.
    mkdir -p "$SINDEN_RUN"
    BROKER_ARGS+=(--control-socket "$SINDEN_CONTROL")
  fi
  if [ -r "$SINDEN_DEVICES_FILE" ]; then
    while IFS= read -r device; do
      case "$device" in ''|'#'*) continue ;; esac
      BROKER_ARGS+=(--device "$device")
    done <"$SINDEN_DEVICES_FILE"
  fi
  python3 "$SINDEN_BROKER" "${BROKER_ARGS[@]}" \
    </dev/null >/dev/null 2>&1 &
  echo $! >"$SINDEN_PID"
  # Never block the ES launch path for long: the broker is checked for an
  # immediate crash (bad config, port in use) with a short bounded wait, then the
  # launcher carries on. Ten ms after a healthy start this is already done.
  attempt=0
  while [ "$attempt" -lt 3 ]; do
    kill -0 "$(cat "$SINDEN_PID" 2>/dev/null)" 2>/dev/null && break
    sleep 0.1
    attempt=$((attempt + 1))
  done
  if ! kill -0 "$(cat "$SINDEN_PID" 2>/dev/null)" 2>/dev/null; then
    rm -f "$SINDEN_PID"
  fi
}

stop_sinden_broker() {
  local pid worker_pid pidfile
  if [ -r "$SINDEN_PID" ]; then
    pid="$(cat "$SINDEN_PID" 2>/dev/null || true)"
    [ -n "$pid" ] && kill -TERM "$pid" 2>/dev/null || true
  fi
  rm -f "$SINDEN_PID"
  for pidfile in "$SINDEN_RUN"/*.worker.pid; do
    [ -r "$pidfile" ] || continue
    worker_pid="$(cat "$pidfile" 2>/dev/null || true)"
    [ -n "$worker_pid" ] && kill -TERM "$worker_pid" 2>/dev/null || true
    rm -f "$pidfile"
  done
  rm -f "$SINDEN_CONTROL" "$SINDEN_RUN"/*.pty
}

start_hotr() {
  [ -x "$DAEMON" ] || { echo "HOTR executable missing: $DAEMON" >>"$LOGFILE"; return 1; }

  # The broker is HOTR's TCP peer, not part of the daemon, so it must come back
  # whenever this service is started - including when the daemon is already up
  # and only the broker died (crash, OOM kill, gun replug). Starting it here
  # before the "already running" shortcut is what makes `service start` a real
  # repair command; start_sinden_broker() is a no-op when it is already running.
  start_sinden_broker
  hotr_running && return 0

  # Refresh the active theme in case it was installed or updated after HOTR.
  [ -x "$ROOT/bin/hotr-theme-sync" ] && "$ROOT/bin/hotr-theme-sync" --active >>"$LOGFILE" 2>&1 || true

  rotate_log
  cleanup_stale_qipc
  export DISPLAY=:0
  export HOME=/userdata/system
  export XDG_CONFIG_HOME=/userdata/system/configs
  # HOTR runs headlessly as a background daemon. Allow an override for
  # hardware/builds that require another Qt backend.
  export QT_QPA_PLATFORM="${HOTR_QT_PLATFORM:-offscreen}"
  export HOTR_DATA_DIR="$DATADIR"
  unset XDG_RUNTIME_DIR

  # Allow user hardware preparation before the daemon opens its devices.
  [ -x "$ROOT/scripts/custom-boot.sh" ] && "$ROOT/scripts/custom-boot.sh" >>"$LOGFILE" 2>&1 || true

  cd "$APPDIR" || return 1
  # Batocera's v44 launcher waits for inherited pipes to close. start-stop-
  # daemon --background closes inherited descriptors. Launch through sh so it
  # reopens stdout/stderr in append mode; --output truncates/reuses the start
  # of the log, which makes tail -F miss Qt's live debug messages.
  if command -v start-stop-daemon >/dev/null 2>&1; then
    rm -f /var/run/hotr-launch.pid
    start-stop-daemon --start --background --make-pidfile \
      --pidfile /var/run/hotr-launch.pid --startas /bin/sh -- \
      -c 'exec "$1" "$2" >>"$3" 2>&1' sh "$DAEMON" "${HOTR_UI_ARGS[0]}" "$LOGFILE"
  elif command -v setsid >/dev/null 2>&1; then
    setsid -f "$DAEMON" "${HOTR_UI_ARGS[@]}" </dev/null >>"$LOGFILE" 2>&1
  else
    nohup "$DAEMON" "${HOTR_UI_ARGS[@]}" </dev/null >>"$LOGFILE" 2>&1 &
  fi

  # Detect an immediate AppImage/Qt/startup failure instead of reporting a
  # successful service start while HOTR has already exited.
  for attempt in 1 2 3 4 5; do
    if hotr_running; then
      service_log "HOTR daemon started successfully (pid(s): $(hotr_pids | tr '\n' ' '))"
      return 0
    fi
    sleep 1
  done
  service_log "HOTR daemon failed to remain running after startup"
  return 1
}

stop_hotr() {
  local pids pid runtime tries
  pids="$(hotr_pids)"
  for pid in $pids; do kill -TERM "$pid" 2>/dev/null || true; done

  tries=0
  while hotr_running && [ "$tries" -lt 10 ]; do
    sleep 1
    tries=$((tries + 1))
  done
  if hotr_running; then
    service_log "HOTR daemon did not stop cleanly; sending SIGKILL"
    for pid in $(hotr_pids); do kill -KILL "$pid" 2>/dev/null || true; done
  fi

  # Normally the AppImage runtime exits with its payload. Clean up a stranded
  # runtime only after the real HOTR payload has gone away.
  for runtime in $(hotr_runtime_pids); do kill -TERM "$runtime" 2>/dev/null || true; done

  stop_sinden_broker

  [ -x "$ROOT/scripts/custom-stop.sh" ] && "$ROOT/scripts/custom-stop.sh" >>"$LOGFILE" 2>&1 || true
}

status_hotr() {
  local pids
  pids="$(hotr_pids)"
  [ -n "$pids" ] || return 1
  for pid in $pids; do printf '%s ' "$pid"; proc_cmdline "$pid"; printf '\n'; done
}

case "${1:-}" in
  start) start_hotr ;;
  stop) stop_hotr ;;
  restart|reload) stop_hotr; sleep 1; start_hotr ;;
  status) status_hotr ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac
