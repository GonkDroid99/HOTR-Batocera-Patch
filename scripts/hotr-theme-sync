#!/bin/bash
# Keep HOTR systems visually identical to normal PSX/PS2 systems.  Only their
# carousel identity changes: EmulationStation falls back to the system's full
# name as text instead of trying to adapt an image to every possible theme.
set -euo pipefail

THEMES="${HOTR_THEME_ROOT:-/userdata/themes}"
SETTINGS="${HOTR_ES_SETTINGS:-/userdata/system/configs/emulationstation/es_settings.cfg}"

active_theme() {
  [ -r "$SETTINGS" ] || return 0
  sed -n 's/.*name="ThemeSet" value="\([^"]*\)".*/\1/p' "$SETTINGS" | head -n1
}

write_override() {
  local theme="$1"
  mkdir -p "$theme/_hotr"

  # These old generated images are deliberately no longer used.
  rm -f "$theme/_hotr/psx.png" "$theme/_hotr/ps2.png"

  cat >"$theme/_hotr/theme.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<theme>
  <formatVersion>7</formatVersion>
  <view name="system">
    <!-- A missing image intentionally triggers the carousel's fullname text
         fallback while every other PSX/PS2 theme property remains unchanged. -->
    <image name="logo" if="${system.name} == 'psx-hotr' || ${system.name} == 'ps2-hotr'">
      <path>${themePath}/_hotr/use-system-fullname-text</path>
    </image>
  </view>
</theme>
EOF
}

inject_override() {
  local theme="$1" source temporary
  source="$theme/theme.xml"
  [ -f "$source" ] || return 0
  temporary="$(mktemp)"

  awk '
    /<!-- HOTR LOGO OVERRIDE BEGIN -->/ { skip = 1; next }
    /<!-- HOTR LOGO OVERRIDE END -->/   { skip = 0; next }
    !skip {
      if (!inserted && $0 ~ /^[[:space:]]*<\/theme>[[:space:]]*$/) {
        print "  <!-- HOTR LOGO OVERRIDE BEGIN -->"
        print "  <include>./_hotr/theme.xml</include>"
        print "  <!-- HOTR LOGO OVERRIDE END -->"
        inserted = 1
      }
      print
    }
  ' "$source" >"$temporary"

  if ! grep -q 'HOTR LOGO OVERRIDE BEGIN' "$temporary"; then
    rm -f "$temporary"
    echo "HOTR: unable to inject text-logo override into $source" >&2
    return 1
  fi
  cat "$temporary" >"$source"
  rm -f "$temporary"
}

sync_theme() {
  local theme="$1"
  [ -f "$theme/theme.xml" ] || return 0
  write_override "$theme"
  inject_override "$theme"
}

remove_override() {
  local theme="$1" source temporary
  source="$theme/theme.xml"
  [ -f "$source" ] || return 0
  temporary="$(mktemp)"
  awk '
    /<!-- HOTR LOGO OVERRIDE BEGIN -->/ { skip = 1; next }
    /<!-- HOTR LOGO OVERRIDE END -->/   { skip = 0; next }
    !skip { print }
  ' "$source" >"$temporary"
  cat "$temporary" >"$source"
  rm -f "$temporary"
  rm -rf "$theme/_hotr"
}

case "${1:---all}" in
  --active)
    theme="$(active_theme)"
    [ -n "$theme" ] && sync_theme "$THEMES/$theme"
    ;;
  --all)
    for theme in "$THEMES"/*; do
      [ -d "$theme" ] && sync_theme "$theme"
    done
    ;;
  --remove)
    for theme in "$THEMES"/*; do
      [ -d "$theme" ] && remove_override "$theme"
    done
    ;;
  *)
    echo "Usage: $0 [--active|--all|--remove]" >&2
    exit 2
    ;;
esac
