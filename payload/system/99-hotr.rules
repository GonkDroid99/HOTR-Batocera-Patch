# Hook of the Reaper — only the Reaper serial workaround.
#
# Batocera already owns the normal light-gun udev rules, including Retro
# Shooter input merging, calibration, permissions, and ID_INPUT_GUN tagging.
# These rules are limited to the RS3/Reaper serial interfaces that Batocera's
# stock rules do not reliably expose on every kernel/device combination.

# 3A-3H Retro Shooter 1 (VID 0483, PID 5750)
# Register the non-standard serial descriptor with option, then keep interface
# 0 on usbhid so Batocera can create its normal gun input device.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0483", ATTR{idProduct}=="5750", RUN+="/bin/sh -c 'modprobe -q option; [ -e /sys/bus/usb-serial/drivers/option1/new_id ] && echo 0483 5750 > /sys/bus/usb-serial/drivers/option1/new_id || true'"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5750", ATTR{bInterfaceNumber}=="00", RUN+="/bin/sh -c 'echo -n %k > /sys/bus/usb/drivers/option/unbind; echo -n %k > /sys/bus/usb/drivers/usbhid/bind'"

# 3A-3H Retro Shooter 2 (VID 0483, PID 5751)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0483", ATTR{idProduct}=="5751", RUN+="/bin/sh -c 'modprobe -q option; [ -e /sys/bus/usb-serial/drivers/option1/new_id ] && echo 0483 5751 > /sys/bus/usb-serial/drivers/option1/new_id || true'"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5751", ATTR{bInterfaceNumber}=="00", RUN+="/bin/sh -c 'echo -n %k > /sys/bus/usb/drivers/option/unbind; echo -n %k > /sys/bus/usb/drivers/usbhid/bind'"

# Stable serial access for Reaper. Interface 02 is HOTR's serial channel.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5750", MODE="0666", GROUP="uucp"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5751", MODE="0666", GROUP="uucp"
SUBSYSTEM=="tty", ENV{ID_SERIAL}=="3AGAME_3A-3H_Retro_Shooter_1_*", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="hotr/rs3reaper-gun1"
SUBSYSTEM=="tty", ENV{ID_SERIAL}=="3AGAME_3A-3H_Retro_Shooter_2_*", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="hotr/rs3reaper-gun2"
SUBSYSTEM=="tty", ENV{ID_SERIAL}=="3AGAME_3A-3H_Retro_Shooter_3_*", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="hotr/rs3reaper-gun3"
SUBSYSTEM=="tty", ENV{ID_SERIAL}=="3AGAME_3A-3H_Retro_Shooter_4_*", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="hotr/rs3reaper-gun4"
