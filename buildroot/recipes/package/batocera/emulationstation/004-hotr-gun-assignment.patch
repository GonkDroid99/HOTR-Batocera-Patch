+void GuiControllersSettings::openHotrGunAssignments(Window* window)
+{
+	struct GunAssignment { int index; int player; std::string label; };
+	std::vector<GunAssignment> guns;
+	std::vector<std::string> gunLines;
+	if (FILE* pipe = popen("/usr/bin/hotr-gun-assignment list", "r"))
+	{
+		char buffer[512];
+		while (fgets(buffer, sizeof(buffer), pipe))
+		{
+			std::string line(buffer);
+			if (!line.empty() && line.back() == '\\n') line.pop_back();
+			gunLines.push_back(line);
+		}
+		pclose(pipe);
+	}
+	for (const auto& line : gunLines)
+	{
+		std::stringstream stream(line);
+		std::string index, player, label;
+		if (!std::getline(stream, index, '\t') || !std::getline(stream, player, '\t') || !std::getline(stream, label))
+			continue;
+		try { guns.push_back({ std::stoi(index), std::stoi(player), label }); }
+		catch (...) { }
+	}
+
+	auto settings = new GuiSettings(window, _("HOTR GUN ASSIGNMENT"));
+	if (guns.empty())
+	{
+		settings->addEntry(_("NO HOTR GUNS DETECTED"), false);
+		window->pushGui(settings);
+		return;
+	}
+
+	std::shared_ptr<std::vector<int>> pending = std::make_shared<std::vector<int>>(guns.size(), 69);
+	for (int player = 1; player <= static_cast<int>(guns.size()); player++)
+	{
+		auto choices = std::make_shared<OptionListComponent<int>>(window,
+			Utils::String::format(_("P%i'S GUN").c_str(), player), false);
+		for (const auto& gun : guns)
+			choices->add(gun.label, gun.index, gun.player == player);
+		choices->add(_("UNASSIGNED"), 69, (*pending)[player - 1] == 69);
+		for (const auto& gun : guns) if (gun.player == player) (*pending)[player - 1] = gun.index;
+		if (!choices->hasSelection())
+			choices->selectFirstItem();
+		settings->addWithLabel(Utils::String::format(_("P%i'S GUN").c_str(), player), choices);
+		choices->setSelectedChangedCallback([pending, player](const int& gun)
+		{
+			(*pending)[player - 1] = gun;
+		});
+	}
+	settings->addEntry(_("SAVE ASSIGNMENTS"), true, [window, pending]()
+	{
+		std::string command = "/usr/bin/hotr-gun-assignment assign-batch";
+		for (size_t i = 0; i < pending->size(); i++)
+			command += " " + std::to_string(i + 1) + " " + std::to_string((*pending)[i]);
+		if (std::system(command.c_str()) != 0)
+			window->pushGui(new GuiMsgBox(window, _("COULD NOT SAVE HOTR GUN ASSIGNMENTS.")));
+		else
+			window->pushGui(new GuiMsgBox(window, _("HOTR GUN ASSIGNMENTS SAVED SUCCESSFULLY.")));
+	});
+	window->pushGui(settings);
+}
