# Copy to buildroot/buildroot.conf and edit.
# Exact Batocera 43/43.1 source checkout is strongly recommended.
BATOCERA_TREE="$HOME/src/batocera.linux-43"
BATOCERA_REPO="https://github.com/batocera-linux/batocera.linux.git"
# Set this to the exact Batocera 43/43.1 commit/tag/branch you want to target.
# Leave empty only when BATOCERA_TREE is already checked out correctly.
BATOCERA_REF=""

# Your patched/custom emulator source trees. These are copied into the
# Batocera source tree before Buildroot starts.
DUCKSTATION_SOURCE="$HOME/src/duckstation-lightgun-src"
PCSX2_SOURCE="$HOME/src/pcsx2-lightgun-src"

# x86_64 is the target for this project.
BATOCERA_TARGET="x86_64"

# If 1, clone BATOCERA_REPO when BATOCERA_TREE doesn't exist.
AUTO_CLONE_BATOCERA=1
